# Copy to .env and fill in. Never commit .env.

# Salt for hashing caller phone numbers (any long random string).
CALLER_SALT=replace-with-a-long-random-string

# SQLite file path (relative paths resolve from the sanket/ root).
DB_PATH=backend/sanket.db

# Frontend origins allowed by CORS (JSON list).
CORS_ORIGINS=["http://localhost:5190"]

# Ingest micro-batching: flush at this many reports or after this many ms.
INGEST_BATCH_SIZE=25
INGEST_BATCH_WAIT_MS=50

# Trained local classifier (python -m scripts.train_local writes it).
LOCAL_MODEL_PATH=backend/artifacts/local_v1.joblib

# Pipeline: reports whose local confidence is below this go to the fast LLM.
CONF_THRESHOLD=0.8

# Fast LLM fallback chain, tried in LLM_CHAIN order (Groq first: ~1 s vs ~8 s for Gemini 3.x Flash).
# A provider is used only when its key is set. Free-tier limits change often:
# set RPM/TPM to your account's current limits.
LLM_CHAIN=["groq","gemini","openrouter","custom"]
GEMINI_API_KEY=
# Each Gemini model has its own free quota and is a separate fallback slot.
GEMINI_MODELS=["gemini-3.5-flash-lite","gemini-3.5-flash"]
GEMINI_RPM=10
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM=30
GROQ_TPM=8000
# Groq also caps output tokens per minute on free models.
GROQ_OTPM=1000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Any OpenAI-compatible endpoint (e.g. Jev) can join the chain:
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Micro-batching for uncertain reports: flush at this many items or after this many ms.
LLM_BATCH_SIZE=25
LLM_BATCH_WAIT_MS=300
