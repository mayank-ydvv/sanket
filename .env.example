# Copy to .env and fill in. Never commit .env.

# Salt for hashing caller phone numbers (any long random string).
CALLER_SALT=replace-with-a-long-random-string

# SQLite file path (relative paths resolve from the sanket/ root).
DB_PATH=backend/sanket.db

# Frontend origins allowed by CORS (JSON list).
CORS_ORIGINS=["http://localhost:5190"]

# Ingest micro-batching: flush at this many reports or after this many ms.
INGEST_BATCH_SIZE=25
INGEST_BATCH_WAIT_MS=50

# Trained local classifier (python -m scripts.train_local writes it).
LOCAL_MODEL_PATH=backend/artifacts/local_v1.joblib

# Pipeline: reports whose local confidence is below this go to the fast LLM.
CONF_THRESHOLD=0.8

# Fast LLM fallback chain, tried in LLM_CHAIN order (Groq first: ~1 s vs ~8 s for Gemini 3.x Flash).
# A provider is used only when its key is set. Free-tier limits change often:
# set RPM/TPM to your account's current limits.
LLM_CHAIN=["groq","gemini","openrouter","custom"]
GEMINI_API_KEY=
# Each Gemini model has its own free quota and is a separate fallback slot.
GEMINI_MODELS=["gemini-3.5-flash-lite","gemini-3.5-flash"]
GEMINI_RPM=10
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM=30
GROQ_TPM=8000
# Groq also caps output tokens per minute on free models.
GROQ_OTPM=1000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Any OpenAI-compatible endpoint (e.g. Jev) can join the chain:
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Micro-batching for uncertain reports: flush at this many items or after this many ms.
LLM_BATCH_SIZE=25
LLM_BATCH_WAIT_MS=300

# Geocoding: known demo places resolve offline from a built-in gazetteer; others go to
# Nominatim (1 req/s, bounded to the district viewbox: west, south, east, north).
GEO_DISTRICT=Noida, Uttar Pradesh
GEO_VIEWBOX=[77.25,28.43,77.55,28.70]
NOMINATIM_USER_AGENT=Sanket-triage-demo/0.1 (hackathon prototype)
GEOCODE_NETWORK=true

# Clustering: join when cosine + department bonus >= CLUSTER_SIMILARITY, within
# CLUSTER_RADIUS_KM and CLUSTER_WINDOW_S. EMBEDDING_BACKEND=hashing runs without the model.
EMBEDDING_BACKEND=sentence
CLUSTER_SIMILARITY=0.70
CLUSTER_DEPARTMENT_BONUS=0.15
CLUSTER_RADIUS_KM=1.0
CLUSTER_WINDOW_S=1800

# Alerts: the mock sender logs alerts; set MOCK_ALERTS=false plus Twilio credentials
# (and phone numbers in ALERT_CONTACTS) to send real SMS. Unacknowledged alerts
# escalate to the next contact after ALERT_ACK_TIMEOUT_S.
MOCK_ALERTS=true
ALERT_ACK_TIMEOUT_S=90
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# ALERT_CONTACTS={"fire":[{"name":"Fire station","phone":"+91..."},{"name":"District fire officer","phone":"+91..."}]}

# Voice + SMS intake (Twilio webhooks through a public tunnel).
# PUBLIC_BASE_URL must be exactly the https URL Twilio calls (e.g. your cloudflared URL).
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_SMS_REPLY=false
VOICE_MAX_SECONDS=60
# Speech-to-text: Groq Whisper uses GROQ_API_KEY above; Sarvam is the fallback (<= 30 s clips).
GROQ_STT_MODEL=whisper-large-v3
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Voice + SMS intake (Twilio webhooks through a public tunnel).
# PUBLIC_BASE_URL must be exactly the https URL Twilio calls (e.g. your cloudflared URL).
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_SMS_REPLY=false
VOICE_MAX_SECONDS=60
# Speech-to-text: Groq Whisper uses GROQ_API_KEY above; Sarvam is the fallback (<= 30 s clips).
GROQ_STT_MODEL=whisper-large-v3
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Cost ticker: list prices in USD per 1M tokens, keyed by model (JSON). Defaults are
# estimates; copy current numbers from each provider's pricing page.
# LLM_PRICES={"qwen/qwen3.8-27b":{"input":0.29,"output":0.59},"gemini-3.5-flash-lite":{"input":0.10,"output":0.40}}
# Counterfactual: every report sent alone to a large reasoning model.
# COUNTERFACTUAL_PRICE={"input":2.50,"output":15.00}
COUNTERFACTUAL_INPUT_TOKENS=1550
COUNTERFACTUAL_OUTPUT_TOKENS=500
USD_TO_INR=84.0

# System 2 reasoning layer (cross-report linking, merge suggestions, crew briefings).
REASONING_ENABLED=true
REASONING_CHAIN=["gemini","openrouter","groq"]
REASONING_GEMINI_MODEL=gemini-3.5-flash
REASONING_DEBOUNCE_S=20

# Dispatcher accounts. Sessions are HMAC-signed cookies; set a long random SESSION_SECRET
# (otherwise one is derived from CALLER_SALT). COOKIE_SECURE=true when served over https.
SESSION_SECRET=
COOKIE_SECURE=false
AUTH_REQUIRED=true

# Demo account created by `python -m scripts.seed_demo` (a random password is printed if empty).
DEMO_EMAIL=demo@sanket.local
DEMO_PASSWORD=

# Demo safety net. DEMO_RECORD=true appends every LLM answer of a live run to DEMO_RUN_PATH;
# DEMO_CACHE=true replays them with the original delays and no network (./run.sh --demo).
DEMO_RECORD=false
DEMO_CACHE=false
DEMO_RUN_PATH=backend/data/demo_run.jsonl
